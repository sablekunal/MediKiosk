# Relative SQLite location is suitable only for development; production should use an encrypted volume.
MEDIKIOSK_DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db
# Absolute path to the approved local GGUF model. Leave unset for deterministic fallback mode.
MEDIKIOSK_LLM_MODEL_PATH=D:/sih/models/qwen2.5-7b/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
MEDIKIOSK_LLM_N_CTX=2048
MEDIKIOSK_LLM_N_GPU_LAYERS=0
MEDIKIOSK_EXTRACTION_RETRIES=2
# faster-whisper model ID; downloaded to the path below on first transcription.
MEDIKIOSK_ASR_MODEL=Systran/faster-whisper-small
MEDIKIOSK_ASR_DEVICE=cpu
MEDIKIOSK_ASR_COMPUTE_TYPE=int8
MEDIKIOSK_ASR_DOWNLOAD_ROOT=./models/asr
# Download a Piper .onnx voice and its matching .onnx.json config, then set both paths.
MEDIKIOSK_TTS_VOICE_MODEL_PATH=
MEDIKIOSK_TTS_VOICE_CONFIG_PATH=
# Preferred multilingual layout: <root>/en/en.onnx, en.onnx.json and <root>/hi/hi.onnx, hi.onnx.json.
MEDIKIOSK_TTS_VOICE_ROOT=./models/tts
MEDIKIOSK_OCR_LANGUAGE=en
MEDIKIOSK_OCR_MODEL_ROOT=./models/ocr
MEDIKIOSK_MAX_MEDIA_BYTES=26214400
